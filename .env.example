# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=
HUD_TOKEN=
CENSUS_KEY=
# Optional: defaults to gemma-4-26b-a4b-it
GEMMA_MODEL=
# Set to 1 to run without a Gemini key (canned extraction for the demo samples)
MOCK_AI=
# Unused unless needed
FRED_API_KEY=

# Optional: self-host Gemma 4 with Ollama
GEMMA_PROVIDER=
GEMMA_BASE_URL=
